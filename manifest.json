  {id:12,name:'Kotak Hantaran Kardus Mewah',cat:'Kotak Hantaran',emoji:'📫',price:55000,origPrice:70000,stock:80,rating:4.7,sold:321,badge:'',new:false,desc:'Kotak hantaran berbahan kardus premium lapis kain beludru, ukuran 25×25×10cm. Ada slot pita & name tag mewah.',reviews:[]},
  {id:13,name:'Set Kotak Hantaran 5 Susun',cat:'Kotak Hantaran',emoji:'🗃️',price:250000,origPrice:320000,stock:20,rating:5.0,sold:98,badge:'Premium',new:false,desc:'Set kotak hantaran bertumpuk 5 buah, bahan MDF lapis kain satin. Ukuran bertingkat 30–50cm. Cocok untuk seserahan pernikahan mewah.',reviews:[{name:'Ayu S.',rating:5,text:'Luar biasa kualitasnya, seserahan jadi makin wow!',date:'1 minggu lalu',avatar:'💒'}]},
