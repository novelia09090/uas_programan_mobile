  {id:10,name:'Pita Grosgrain Polkadot',cat:'Pita Dekorasi',emoji:'🎗️',price:10000,origPrice:13000,stock:280,rating:4.7,sold:987,badge:'New',new:true,desc:'Pita grosgrain tekstur bertitik, lebar 1.5cm, panjang 5m. Tidak mudah lecek, cocok untuk pita kado, dekorasi rambut & craft.',reviews:[]},
