  {id:15,name:'Kartu Ucapan Emboss Bintang',cat:'Kartu Ucapan',emoji:'🌟',price:22000,origPrice:28000,stock:130,rating:4.8,sold:876,badge:'',new:false,desc:'Kartu ucapan embossed motif bintang & moon, ukuran A6. Kertas premium, cocok untuk ulang tahun, anniversary & wisuda.',reviews:[]},
  {id:16,name:'Kartu Ucapan Set Luxury 5pcs',cat:'Kartu Ucapan',emoji:'📝',price:85000,origPrice:110000,stock:55,rating:4.9,sold:456,badge:'New',new:true,desc:'Set 5 kartu ucapan mewah embossed berbeda motif. Bahan hardcover 400gsm, finishing foil gold. Dilengkapi amplop cokelat kraft.',reviews:[]},
  {id:17,name:'Balon Latex Metalik 12pcs',cat:'Balon Foil',emoji:'🎊',price:28000,origPrice:35000,stock:400,rating:4.7,sold:3456,badge:'',new:false,desc:'Balon latex metalik isi 12pcs, diameter 30cm. Pilihan warna: gold, silver, rose gold, chrome pink. Cocok untuk pesta & dekorasi.',reviews:[]},
  {id:18,name:'Kertas Tisu Dekorasi Set',cat:'Kertas Kado',emoji:'🌈',price:18000,origPrice:22000,stock:200,rating:4.6,sold:765,badge:'New',new:true,desc:'Set kertas tisu dekorasi warna-warni isi 30 lembar, cocok untuk mengisi kotak kado, hamper, dan dekorasi.',reviews:[]},
];

const CATEGORIES = [
  {name:'Semua',emoji:'🌈'},{name:'Balon Foil',emoji:'🎈'},
  {name:'Kertas Kado',emoji:'🌸'},{name:'Pita Dekorasi',emoji:'🎀'},
  {name:'Kotak Hantaran',emoji:'🎁'},{name:'Kartu Ucapan',emoji:'💌'}
];

const VOUCHERS = [
  {code:'PARTY20',label:'Diskon 20%',desc:'Potongan 20% untuk semua produk',min:0,type:'pct',val:20},
  {code:'BLISS15',label:'Diskon 15%',desc:'Hemat 15% belanja di PartyBliss',min:50000,type:'pct',val:15},
  {code:'ULTAH25',label:'Diskon 25%',desc:'Spesial ulang tahun, diskon 25%!',min:100000,type:'pct',val:25},
  {code:'ONGKIR',label:'Gratis Ongkir',desc:'Bebas ongkir ke seluruh Indonesia',min:0,type:'ship',val:0},
  {code:'GIFT50',label:'Potongan Rp 50.000',desc:'Diskon langsung Rp 50.000',min:200000,type:'flat',val:50000},
];

const PAY_METHODS = [
  {id:'transfer_bca',icon:'🏦',label:'Transfer BCA'},
  {id:'transfer_mandiri',icon:'🏦',label:'Transfer Mandiri'},
  {id:'qris',icon:'📱',label:'QRIS'},
  {id:'gopay',icon:'💚',label:'GoPay'},
  {id:'ovo',icon:'💜',label:'OVO'},
  {id:'cod',icon:'💵',label:'COD'},
];

// ─────────────────── STATE ───────────────────
let cart = JSON.parse(localStorage.getItem('pb_cart2')||'[]');
let orders = JSON.parse(localStorage.getItem('pb_orders2')||'[]');
let wishlist = JSON.parse(localStorage.getItem('pb_wish')||'[]');
let activeFilter = 'Semua';
let sortMode = 'default';
let currentPdId = null;
let sheetQty = 1;
let selectedVoucher = null;
let selectedPayMethod = 'qris';
let bannerIdx = 0;
let bannerInterval = null;
let flashSeconds = 9930;
let orderStatusFilter = 'Semua';

const fmt = n => 'Rp ' + n.toLocaleString('id-ID');
const save = () => {
  localStorage.setItem('pb_cart2', JSON.stringify(cart));
  localStorage.setItem('pb_orders2', JSON.stringify(orders));
  localStorage.setItem('pb_wish', JSON.stringify(wishlist));
};

function toast(msg, dur=2200){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),dur);
}

// ─────────────────── BANNER ───────────────────
function initBanner(){
  const dots = document.getElementById('banner-dots');
  dots.innerHTML = [0,1,2,3].map((i)=>`<div class="dot ${i===0?'active':''}" onclick="goBanner(${i})"></div>`).join('');
  clearInterval(bannerInterval);
  bannerInterval = setInterval(()=>goBanner((bannerIdx+1)%4), 3500);
}
function goBanner(i){
  bannerIdx=i;
  document.getElementById('banner-track').style.transform=`translateX(-${i*100}%)`;
  document.querySelectorAll('.dot').forEach((d,j)=>d.classList.toggle('active',j===i));
}

// ─────────────────── FLASH TIMER ───────────────────
setInterval(()=>{
  if(flashSeconds>0) flashSeconds--;
  const h=String(Math.floor(flashSeconds/3600)).padStart(2,'0');
  const m=String(Math.floor((flashSeconds%3600)/60)).padStart(2,'0');
  const s=String(flashSeconds%60).padStart(2,'0');
  const el=document.getElementById('flash-timer');
  if(el) el.textContent=`${h}:${m}:${s}`;
},1000);

// ─────────────────── RENDER HELPERS ───────────────────
function starStr(r){
  const full=Math.floor(r), half=r%1>=.5?1:0;
  return '★'.repeat(full)+( half?'½':'')+('☆'.repeat(5-full-half));
}

function pcCard(p, showAddCart=true){
  const disc = Math.round((1-p.price/p.origPrice)*100);
  const inWish = wishlist.includes(p.id);
  return `<div class="pc" onclick="openProduct(${p.id})">
    <div class="pc-img" style="background:${catBg(p.cat)}">
      ${disc>0?`<div class="pc-disc">-${disc}%</div>`:''}
      ${p.badge?`<div class="pc-badge">${p.badge}</div>`:''}
      <button class="heart-btn ${inWish?'loved':''}" onclick="event.stopPropagation();toggleWish(${p.id})">${inWish?'❤️':'🤍'}</button>
      ${p.emoji}
    </div>
    <div class="pc-body">
      <div class="pc-name">${p.name}</div>
      <div style="margin-bottom:3px"><span class="mini-stars">${'★'.repeat(Math.round(p.rating))}</span> <span style="font-size:0.68rem;color:var(--ink3)">${p.rating}</span></div>
      <div><span class="pc-price">${fmt(p.price)}</span><span class="pc-orig">${fmt(p.origPrice)}</span></div>
      <div class="pc-sold">${p.sold.toLocaleString('id-ID')} terjual</div>
      ${showAddCart?`<button class="pc-add" onclick="event.stopPropagation();addCart(${p.id},1)">+ Keranjang</button>`:''}
    </div>
  </div>`;
}

function catBg(cat){
  return {'Balon Foil':'#FFF0F6','Kertas Kado':'#FFF8E1','Pita Dekorasi':'#EDE9FE','Kotak Hantaran':'#E0FFF8','Kartu Ucapan':'#F0FFF4'}[cat]||'#F8F7FF';
}

// ─────────────────── HOME ───────────────────
function renderHome(){
  // cats
  document.getElementById('home-cats').innerHTML = CATEGORIES.filter(c=>c.name!=='Semua').map(c=>`
    <div class="cat-chip" onclick="filterAndGo('${c.name}')">
      <div class="cc-icon">${c.emoji}</div>
      <div class="cc-lbl">${c.name}</div>
    </div>`).join('');
  // flash sale (cheapest)
  const flash=[...PRODUCTS].sort((a,b)=>a.price-b.price).slice(0,8);
  document.getElementById('flash-sale-row').innerHTML=flash.map(p=>pcCard(p)).join('');
  // new arrival
  const newArr=PRODUCTS.filter(p=>p.new);
  document.getElementById('new-arrival-row').innerHTML=newArr.map(p=>pcCard(p)).join('');
  // bestseller
  const best=[...PRODUCTS].sort((a,b)=>b.sold-a.sold).slice(0,6);
  document.getElementById('bestseller-grid').innerHTML=best.map(p=>pcCard(p)).join('');
  initBanner();
}

function filterAndGo(cat){
  activeFilter=cat;
  showPage('shop');
}

// ─────────────────── SHOP ───────────────────
function renderShop(){
  // filter chips
  document.getElementById('shop-filters').innerHTML = CATEGORIES.map(c=>`
    <div class="f-chip ${c.name===activeFilter?'active':''}" onclick="setFilter('${c.name}')">${c.emoji} ${c.name}</div>`).join('');
  // sort & filter
  let list = PRODUCTS.filter(p => activeFilter==='Semua' || p.cat===activeFilter);
  const q=(document.getElementById('search-input')?.value||'').toLowerCase();
  if(q) list=list.filter(p=>p.name.toLowerCase().includes(q)||p.cat.toLowerCase().includes(q));
  if(sortMode==='price_asc') list=[...list].sort((a,b)=>a.price-b.price);
  else if(sortMode==='price_desc') list=[...list].sort((a,b)=>b.price-a.price);
  else if(sortMode==='rating') list=[...list].sort((a,b)=>b.rating-a.rating);
  else if(sortMode==='sold') list=[...list].sort((a,b)=>b.sold-a.sold);
  document.getElementById('shop-grid').innerHTML=list.length?list.map(p=>pcCard(p)).join(''):'<p style="color:var(--ink3);padding:2rem;grid-column:1/-1">Produk tidak ditemukan 😔</p>';
}
function setFilter(f){activeFilter=f;renderShop();}
function setSort(s,el){sortMode=s;document.querySelectorAll('.sort-btn').forEach(b=>b.classList.remove('active'));el.classList.add('active');renderShop();}
function liveSearch(){renderShop();}

// ─────────────────── CART ───────────────────
function addCart(id, qty=1){
  const p=PRODUCTS.find(x=>x.id===id);
  const ex=cart.find(c=>c.id===id);
  if(ex) ex.qty+=qty;
  else cart.push({id,name:p.name,price:p.price,origPrice:p.origPrice,emoji:p.emoji,cat:p.cat,qty,checked:true});
  save(); updateBadges();
  toast(`✅ ${p.name} ditambahkan!`);
}

function updateBadges(){
  const total=cart.reduce((s,c)=>s+c.qty,0);
  document.getElementById('cart-badge').textContent=total;
  const bn=document.getElementById('bn-cart-badge');
  if(bn){bn.textContent=total;bn.style.display=total>0?'flex':'none';}
}

function renderCart(){
  const body=document.getElementById('cart-body');
  const sticky=document.getElementById('cart-sticky');
  if(!cart.length){
    body.innerHTML=`<div class="cart-empty"><span class="big-icon">🛒</span><p>Keranjang masih kosong<br>Yuk mulai belanja!</p><button class="go-shop-btn" onclick="showPage('shop')">Mulai Belanja 🛍️</button></div>`;
    sticky.style.display='none'; return;
  }
  sticky.style.display='block';
  // group by category
  const cats=[...new Set(cart.map(c=>c.cat))];
  body.innerHTML = cats.map(cat=>{
    const items=cart.filter(c=>c.cat===cat);
    return `<div>
      <div class="cart-section-title">${catEmoji(cat)} ${cat}</div>
      ${items.map((item,gi)=>{
        const i=cart.indexOf(item);
        return `<div class="cart-item">
          <div class="ci-check ${item.checked?'checked':''}" onclick="toggleCheck(${i})">✓</div>
          <div class="ci-emoji" style="background:${catBg(item.cat)}">${item.emoji}</div>
          <div class="ci-info">
            <div class="ci-name">${item.name}</div>
            <div class="ci-variant">${item.cat}</div>
            <div class="ci-bottom">
              <div class="ci-price-big">${fmt(item.price*item.qty)}</div>
              <div class="qty-ctrl">
                <button class="qty-btn" onclick="changeQty(${i},-1)">−</button>
                <span class="qty-n">${item.qty}</span>
                <button class="qty-btn" onclick="changeQty(${i},1)">+</button>
              </div>
            </div>
          </div>
          <button onclick="removeItem(${i})" style="background:none;border:none;color:var(--ink3);cursor:pointer;font-size:1rem;padding:4px;align-self:flex-start">🗑️</button>
        </div>`;
      }).join('')}
    </div>`;
  }).join('');
  calcCartTotal();
}

function catEmoji(cat){return CATEGORIES.find(c=>c.name===cat)?.emoji||'📦';}

function toggleCheck(i){cart[i].checked=!cart[i].checked;save();renderCart();}
function toggleAll(){
  const allChecked=cart.every(c=>c.checked);
  cart.forEach(c=>c.checked=!allChecked);
  save();renderCart();
}

function calcCartTotal(){
  const checked=cart.filter(c=>c.checked);
  const total=checked.reduce((s,c)=>s+c.price*c.qty,0);
  document.getElementById('cart-total-num').textContent=fmt(total);
  document.getElementById('selected-count').textContent=checked.reduce((s,c)=>s+c.qty,0);
  document.getElementById('checkout-go-btn').disabled=checked.length===0;
  const allBox=document.getElementById('all-check-box');
  if(allBox) allBox.className='check-box'+(cart.length&&cart.every(c=>c.checked)?' all-checked':'');
}

function changeQty(i,d){
  cart[i].qty=Math.max(1,cart[i].qty+d);
  save();renderCart();
}
function removeItem(i){cart.splice(i,1);save();updateBadges();renderCart();}

// ─────────────────── CHECKOUT ───────────────────
function renderCheckout(){
  const checked=cart.filter(c=>c.checked);
  // items preview
  document.getElementById('ck-items-preview').innerHTML=`<div class="ck-section"><div class="ck-section-title">🛍️ Produk Dipesan</div>${
    checked.map(c=>`<div class="ck-row"><span>${c.emoji} ${c.name} ×${c.qty}</span><span class="ck-val">${fmt(c.price*c.qty)}</span></div>`).join('')
  }</div>`;
  // pay methods
  document.getElementById('pay-method-grid').innerHTML=PAY_METHODS.map(p=>`
    <div class="pay-opt ${selectedPayMethod===p.id?'active':''}" onclick="setPayMethod('${p.id}')">
      <span class="pay-icon">${p.icon}</span>${p.label}
    </div>`).join('');
  calcCkSummary();
}

function setPayMethod(id){selectedPayMethod=id;renderCheckout();}

function calcCkSummary(){
  const checked=cart.filter(c=>c.checked);
  const sub=checked.reduce((s,c)=>s+c.price*c.qty,0);
  const shipOpt=document.getElementById('ck-shipping')?.value||'regular';
  const shipCost={'regular':15000,'express':25000,'same_day':35000,'free':sub>=150000?0:15000}[shipOpt]||15000;
  let disc=0, discLabel='';
  if(selectedVoucher){
    const v=VOUCHERS.find(x=>x.code===selectedVoucher);
    if(v){
      if(v.type==='pct') disc=Math.round(sub*v.val/100);
      else if(v.type==='flat') disc=Math.min(v.val,sub);
      else if(v.type==='ship') disc=shipCost;
      discLabel=` (${v.code})`;
    }
  }
  const grand=sub+shipCost-disc;
  document.getElementById('ck-summary').innerHTML=`
    <div class="ck-row"><span class="ck-label">Subtotal</span><span class="ck-val">${fmt(sub)}</span></div>
    <div class="ck-row"><span class="ck-label">Ongkos Kirim</span><span class="ck-val">${fmt(shipCost)}</span></div>
    ${disc?`<div class="ck-row"><span class="ck-label" style="color:var(--gr)">Diskon${discLabel}</span><span class="ck-val" style="color:var(--gr)">−${fmt(disc)}</span></div>`:''}`;
  document.getElementById('ck-grand-total').textContent=fmt(grand);
}

function placeOrder(){
  const name=document.getElementById('ck-name').value.trim();
  const phone=document.getElementById('ck-phone').value.trim();
  const addr=document.getElementById('ck-addr').value.trim();
  const city=document.getElementById('ck-city').value;
  if(!name||!phone||!addr||!city){toast('⚠️ Lengkapi semua data pengiriman!');return;}
  const checked=cart.filter(c=>c.checked);
  if(!checked.length){toast('⚠️ Pilih produk dulu!');return;}
  const sub=checked.reduce((s,c)=>s+c.price*c.qty,0);
  const shipOpt=document.getElementById('ck-shipping').value;
  const shipCost={'regular':15000,'express':25000,'same_day':35000,'free':sub>=150000?0:15000}[shipOpt]||15000;
  let disc=0;
  if(selectedVoucher){
    const v=VOUCHERS.find(x=>x.code===selectedVoucher);
    if(v){
      if(v.type==='pct') disc=Math.round(sub*v.val/100);
      else if(v.type==='flat') disc=Math.min(v.val,sub);
      else if(v.type==='ship') disc=shipCost;
    }
  }
  const grand=sub+shipCost-disc;
  const id='PB'+Date.now().toString().slice(-8);
  const order={id,name,phone,addr,city,items:[...checked],sub,shipCost,disc,grand,
    method:selectedPayMethod,voucher:selectedVoucher||'',
    date:new Date().toLocaleString('id-ID'),status:'Menunggu Pembayaran',
    shipping:shipOpt};
  orders.unshift(order);
  // remove checked items
  cart=cart.filter(c=>!c.checked);
  selectedVoucher=null;
  save(); updateBadges();

  document.getElementById('sm-detail').innerHTML=`
    <div class="sm-row"><span>ID Pesanan</span><span><strong>#${id}</strong></span></div>
    <div class="sm-row"><span>Nama</span><span>${name}</span></div>
    <div class="sm-row"><span>${city}</span><span>${addr.substring(0,25)}...</span></div>
    <div class="sm-row"><span>Metode</span><span>${PAY_METHODS.find(p=>p.id===selectedPayMethod)?.label||selectedPayMethod}</span></div>
    <div class="sm-row"><span>Total Bayar</span><span>${fmt(grand)}</span></div>`;
  document.getElementById('success-modal').classList.add('open');
}

function closeSuccess(){
  document.getElementById('success-modal').classList.remove('open');
  showPage('orders');
}

// ─────────────────── ORDERS ───────────────────
function renderOrders(){
  const total=orders.length;
  const rev=orders.filter(o=>o.status==='Lunas'||o.status==='Selesai').reduce((s,o)=>s+o.grand,0);
  const pending=orders.filter(o=>o.status==='Menunggu Pembayaran').length;
  const process=orders.filter(o=>o.status==='Diproses').length;
  document.getElementById('order-stats').innerHTML=`
    <div class="stat-card"><div class="stat-emoji">📦</div><div class="stat-val">${total}</div><div class="stat-lbl">Total Pesanan</div></div>
    <div class="stat-card"><div class="stat-emoji">⏳</div><div class="stat-val gold">${pending}</div><div class="stat-lbl">Menunggu Bayar</div></div>
    <div class="stat-card"><div class="stat-emoji">🚚</div><div class="stat-val pu">${process}</div><div class="stat-lbl">Diproses</div></div>
    <div class="stat-card"><div class="stat-emoji">💰</div><div class="stat-val gr" style="font-size:1rem;padding-top:4px">${fmt(rev)}</div><div class="stat-lbl">Total Pendapatan</div></div>`;

  const statuses=['Semua','Menunggu Pembayaran','Diproses','Dikirim','Selesai','Dibatalkan'];
  document.getElementById('order-filters').innerHTML=statuses.map(s=>`
    <div class="f-chip ${s===orderStatusFilter?'active':''}" onclick="filterOrders('${s}')">${s}</div>`).join('');

  const list=orderStatusFilter==='Semua'?orders:orders.filter(o=>o.status===orderStatusFilter);
  if(!list.length){
    document.getElementById('orders-list').innerHTML='<div style="text-align:center;padding:3rem;color:var(--ink3)"><div style="font-size:3rem">📭</div><p style="margin-top:8px">Belum ada pesanan</p></div>';
    return;
  }

  const statusClass={
    'Menunggu Pembayaran':'sp-pending','Diproses':'sp-process',
    'Dikirim':'sp-process','Lunas':'sp-paid','Selesai':'sp-done','Dibatalkan':'sp-cancel'
  };

  document.getElementById('orders-list').innerHTML=list.map(o=>`
    <div class="order-card">
      <div class="oc-top">
        <div class="oc-id">#${o.id} · ${o.date}</div>
        <span class="status-pill ${statusClass[o.status]||'sp-pending'}">${o.status}</span>
      </div>
      <div class="oc-items-row">${o.items.map(i=>`
        <div class="oc-item-thumb">
          <div class="oc-thumb-img">${i.emoji}</div>
          <div class="oc-thumb-qty">${i.name.substring(0,12)}... ×${i.qty}</div>
        </div>`).join('')}
      </div>
      <div class="oc-meta">
        <div class="oc-customer-info">
          👤 ${o.name}<br>📱 ${o.phone}<br>📍 ${o.city}<br>
          💳 ${PAY_METHODS.find(p=>p.id===o.method)?.label||o.method}
          ${o.voucher?`<br>🏷️ ${o.voucher}`:''}
        </div>
        <div class="oc-price-section">
          <div style="font-size:0.72rem;color:var(--ink3)">Total</div>
          <div class="oc-total">${fmt(o.grand)}</div>
        </div>
      </div>
      <div class="oc-actions">
        ${o.status==='Menunggu Pembayaran'?`<button class="oc-btn oc-btn-pay" onclick="updateOrderStatus('${o.id}','Diproses')">✅ Konfirmasi Bayar</button>`:''}
        ${o.status==='Diproses'?`<button class="oc-btn oc-btn-done" onclick="updateOrderStatus('${o.id}','Dikirim')">🚚 Tandai Dikirim</button>`:''}
        ${o.status==='Dikirim'?`<button class="oc-btn oc-btn-done" onclick="updateOrderStatus('${o.id}','Selesai')">✅ Pesanan Diterima</button>`:''}
        ${['Menunggu Pembayaran','Diproses'].includes(o.status)?`<button class="oc-btn oc-btn-cancel" onclick="updateOrderStatus('${o.id}','Dibatalkan')">Batalkan</button>`:''}
        ${o.status==='Selesai'?`<button class="oc-btn" style="background:var(--pk4);color:var(--pk);border:1px solid var(--pk2)" onclick="reorder('${o.id}')">🔁 Beli Lagi</button>`:''}
      </div>
    </div>`).join('');
}

function filterOrders(s){orderStatusFilter=s;renderOrders();}
function updateOrderStatus(id,status){
  const o=orders.find(x=>x.id===id);
  if(o){o.status=status;save();renderOrders();toast(`📦 Status: ${status}`);}
}
function reorder(id){
  const o=orders.find(x=>x.id===id);
  if(!o)return;
  o.items.forEach(item=>{
    const ex=cart.find(c=>c.id===item.id);
    if(ex)ex.qty+=item.qty;
    else cart.push({...item,checked:true});
  });
  save();updateBadges();showPage('cart');toast('🛒 Produk ditambahkan ke keranjang!');
}

// ─────────────────── WISHLIST ───────────────────
function toggleWish(id){
  if(wishlist.includes(id)) wishlist=wishlist.filter(x=>x!==id), toast('💔 Dihapus dari wishlist');
  else wishlist.push(id), toast('❤️ Ditambahkan ke wishlist!');
  save(); renderWishlist();
}
function renderWishlist(){
  const body=document.getElementById('wishlist-body');
  const prods=PRODUCTS.filter(p=>wishlist.includes(p.id));
  if(!prods.length){
    body.innerHTML='<div class="empty-wish"><div style="font-size:3.5rem">💔</div><p style="color:var(--ink3);margin-top:10px">Wishlist masih kosong</p><br><button class="go-shop-btn" onclick="showPage(\'shop\')">Jelajahi Produk</button></div>';
  } else {
    body.innerHTML=`<div class="prod-grid">${prods.map(p=>pcCard(p)).join('')}</div>`;
  }
}

// ─────────────────── PRODUCT DETAIL ───────────────────
function openProduct(id){
  const p=PRODUCTS.find(x=>x.id===id);
  if(!p)return;
  currentPdId=id; sheetQty=1;
  document.getElementById('pd-emoji').textContent=p.emoji;
  document.getElementById('pd-cat').textContent=p.cat;
  document.getElementById('pd-name').textContent=p.name;
  document.getElementById('pd-stars').textContent=starStr(p.rating);
  document.getElementById('pd-rating').textContent=p.rating+' / 5';
  document.getElementById('pd-sold-info').textContent=`· ${p.sold.toLocaleString('id-ID')} terjual`;
  document.getElementById('pd-price').textContent=fmt(p.price);
  document.getElementById('pd-orig').textContent=`Harga normal: ${fmt(p.origPrice)}`;
  document.getElementById('pd-desc').textContent=p.desc;
  document.getElementById('sheet-qty').textContent=1;
  document.getElementById('pd-wish-btn').textContent=wishlist.includes(id)?'❤️ Tersimpan':'🤍 Simpan';
  // reviews
  const revEl=document.getElementById('pd-reviews');
  if(p.reviews&&p.reviews.length){
    revEl.innerHTML=p.reviews.map(r=>`
      <div class="review-item">
        <div class="ri-top">
          <div class="ri-avatar">${r.avatar}</div>
          <div class="ri-name">${r.name}</div>
          <span style="color:var(--gd);font-size:0.75rem">${'★'.repeat(r.rating)}</span>
          <span class="ri-date">${r.date}</span>
        </div>
        <div class="ri-text">${r.text}</div>
      </div>`).join('');
  } else {
    revEl.innerHTML='<div style="font-size:0.8rem;color:var(--ink3);padding:12px 0">Belum ada ulasan untuk produk ini.</div>';
  }
  document.getElementById('pd-sheet').classList.add('open');
}
function closeSheet(){document.getElementById('pd-sheet').classList.remove('open');}
function sheetQtyChange(d){sheetQty=Math.max(1,sheetQty+d);document.getElementById('sheet-qty').textContent=sheetQty;}
function addFromSheet(){addCart(currentPdId,sheetQty);closeSheet();}
function toggleWishlist(){
  toggleWish(currentPdId);
  document.getElementById('pd-wish-btn').textContent=wishlist.includes(currentPdId)?'❤️ Tersimpan':'🤍 Simpan';
  // re-render visible page
  renderWishlist();
}

// ─────────────────── VOUCHER ───────────────────
function openVoucherModal(){
  const list=document.getElementById('voucher-list');
  list.innerHTML=VOUCHERS.map(v=>`
    <div class="voucher-item ${selectedVoucher===v.code?'selected':''}" onclick="selectVoucher('${v.code}')">
      <div class="vi-code">${v.code}</div>
      <div class="vi-desc">${v.label} — ${v.desc}</div>
      <div class="vi-min">${v.min?'Min. belanja '+fmt(v.min):' Tanpa minimal belanja'}</div>
      ${selectedVoucher===v.code?'<span class="vi-check">✅</span>':''}
    </div>`).join('');
  document.getElementById('voucher-modal').classList.add('open');
}
function closeVoucherModal(){document.getElementById('voucher-modal').classList.remove('open');}
function selectVoucher(code){
  selectedVoucher=selectedVoucher===code?null:code;
  openVoucherModal();
}
function applyCustomPromo(){
  const code=document.getElementById('promo-custom').value.toUpperCase().trim();
  const v=VOUCHERS.find(x=>x.code===code);
  if(v){selectedVoucher=code;toast('✅ Voucher '+code+' berhasil!');closeVoucherModal();}
  else toast('❌ Kode promo tidak valid');
}
function confirmVoucher(){
  if(selectedVoucher){
    document.getElementById('voucher-label').textContent=`✅ ${selectedVoucher} diterapkan`;
    toast('✅ Voucher '+selectedVoucher+' berhasil!');
  } else {
    document.getElementById('voucher-label').textContent='Pakai Voucher / Kode Promo';
  }
  closeVoucherModal();
  calcCkSummary();
}

// ─────────────────── PROFILE ───────────────────
function renderProfile(){
  const done=orders.filter(o=>o.status==='Selesai').length;
  const rev=orders.filter(o=>o.status==='Selesai').reduce((s,o)=>s+o.grand,0);
  document.getElementById('ph-stats').innerHTML=`
    <div class="ph-stat"><div class="ph-stat-val">${orders.length}</div><div class="ph-stat-lbl">Pesanan</div></div>
    <div class="ph-stat"><div class="ph-stat-val">${wishlist.length}</div><div class="ph-stat-lbl">Wishlist</div></div>
    <div class="ph-stat"><div class="ph-stat-val">${done}</div><div class="ph-stat-lbl">Selesai</div></div>`;
}

// ─────────────────── PAGE ROUTING ───────────────────
function showPage(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.getElementById('page-'+p).classList.add('active');
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active',b.dataset.page===p));
  document.querySelectorAll('.bn-btn').forEach(b=>b.classList.toggle('active',b.dataset.page===p));
  if(p==='home') renderHome();
  if(p==='shop') renderShop();
  if(p==='cart') renderCart();
  if(p==='checkout') renderCheckout();
  if(p==='orders') renderOrders();
  if(p==='wishlist') renderWishlist();
  if(p==='profile') renderProfile();
  window.scrollTo({top:0,behavior:'smooth'});
}

// ─────────────────── SCROLL TOP ───────────────────
window.addEventListener('scroll',()=>{
  const btn=document.getElementById('scroll-top');
  btn.classList.toggle('show',window.scrollY>300);
});

// ─────────────────── SWIPE BANNER ───────────────────
let touchStartX=0;
document.getElementById('banner-track')?.addEventListener('touchstart',e=>touchStartX=e.touches[0].clientX,{passive:true});
document.getElementById('banner-track')?.addEventListener('touchend',e=>{
  const diff=touchStartX-e.changedTouches[0].clientX;
  if(Math.abs(diff)>50) goBanner(diff>0?(bannerIdx+1)%4:(bannerIdx+3)%4);
},{passive:true});

// ─────────────────── CLOSE SHEET ON OVERLAY CLICK ───────────────────
document.getElementById('pd-sheet').addEventListener('click',function(e){
  if(e.target===this) closeSheet();
});

// ─────────────────── INIT ───────────────────
updateBadges();
renderHome();
</script>
</body>
</html>
