<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>PartyBliss ✨</title>
<meta name="theme-color" content="#FF2D7A">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="PartyBliss">
<link rel="manifest" href="manifest.json">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&display=swap" rel="stylesheet">
<style>
:root {
  --pk: #FF2D7A; --pk2: #FF6BA8; --pk3: #FFD6E7; --pk4: #FFF0F6;
  --gd: #FFB800; --gd2: #FFD84D; --gd3: #FFF8E1;
  --pu: #7C3AED; --pu2: #C4B5FD; --pu3: #EDE9FE;
  --tl: #0ABFBC; --gr: #10B981;
  --bg: #F8F7FF; --white: #FFFFFF;
  --ink: #0F0E1A; --ink2: #3D3C52; --ink3: #8B8AAA;
  --bdr: #EEEDF8; --card: #FFFFFF;
  --sh: 0 2px 16px rgba(255,45,122,0.10);
  --sh2: 0 8px 32px rgba(255,45,122,0.18);
  --r: 14px; --r2: 22px; --r3: 50px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{font-family:'Sora',sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;overflow-x:hidden}

/* ── TOPBAR ── */
#topbar{background:linear-gradient(135deg,var(--pk) 0%,#C2005A 100%);padding:0 16px;position:sticky;top:0;z-index:200;box-shadow:0 2px 12px rgba(255,45,122,0.3)}
.tb-row1{display:flex;align-items:center;gap:10px;height:52px}
.tb-logo{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:900;color:#fff;letter-spacing:-1px;flex-shrink:0;cursor:pointer}
.tb-logo span{color:var(--gd2)}
.tb-search{flex:1;background:rgba(255,255,255,0.15);border:1.5px solid rgba(255,255,255,0.3);border-radius:var(--r3);padding:8px 16px 8px 38px;font-family:'Sora',sans-serif;font-size:0.82rem;color:#fff;outline:none;transition:.2s;min-width:0}
.tb-search::placeholder{color:rgba(255,255,255,0.7)}
.tb-search:focus{background:rgba(255,255,255,0.25);border-color:rgba(255,255,255,0.6)}
.search-wrap-tb{position:relative;flex:1;min-width:0}
.search-icon-tb{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:0.9rem;pointer-events:none}
.tb-icons{display:flex;gap:4px;flex-shrink:0}
.tb-icon-btn{background:rgba(255,255,255,0.15);border:none;border-radius:10px;padding:7px 10px;cursor:pointer;font-size:1rem;color:#fff;position:relative;transition:.15s}
.tb-icon-btn:hover{background:rgba(255,255,255,0.3)}
.tb-badge{position:absolute;top:-4px;right:-4px;background:var(--gd);color:#fff;border-radius:50%;width:18px;height:18px;font-size:0.65rem;font-weight:700;display:flex;align-items:center;justify-content:center}
.tb-row2{display:flex;gap:0;border-top:1px solid rgba(255,255,255,0.15)}
.tab-btn{flex:1;background:none;border:none;color:rgba(255,255,255,0.75);font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:500;padding:10px 4px;cursor:pointer;transition:.2s;border-bottom:2.5px solid transparent;display:flex;flex-direction:column;align-items:center;gap:2px}
.tab-btn .ti{font-size:1rem}
.tab-btn.active{color:#fff;border-bottom-color:#fff;font-weight:700}
.tab-btn:hover{color:#fff}

/* ── PAGES ── */
.page{display:none;min-height:calc(100vh - 104px);padding-bottom:80px}
.page.active{display:block}

/* ── HERO BANNER (Swipeable) ── */
.banner-wrap{position:relative;overflow:hidden;border-radius:0}
.banner-track{display:flex;transition:transform .4s cubic-bezier(.4,0,.2,1)}
.banner-slide{min-width:100%;height:180px;display:flex;align-items:center;padding:20px 24px;position:relative;overflow:hidden;flex-shrink:0}
.bs0{background:linear-gradient(135deg,#FF2D7A 0%,#FF8CB4 60%,#FFD6E7 100%)}
.bs1{background:linear-gradient(135deg,#7C3AED 0%,#A78BFA 60%,#EDE9FE 100%)}
.bs2{background:linear-gradient(135deg,#FFB800 0%,#FFD84D 60%,#FFF8E1 100%)}
.bs3{background:linear-gradient(135deg,#0ABFBC 0%,#7FEEED 60%,#E0FFFE 100%)}
.banner-text h2{font-family:'Fraunces',serif;font-size:1.4rem;font-weight:900;color:#fff;line-height:1.2;margin-bottom:6px;text-shadow:0 2px 8px rgba(0,0,0,.15)}
.banner-text p{font-size:0.75rem;color:rgba(255,255,255,.9);margin-bottom:12px}
.banner-btn{background:#fff;border:none;border-radius:var(--r3);padding:7px 18px;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;cursor:pointer;transition:.2s}
.banner-btn:hover{transform:scale(1.04)}
.banner-emoji{position:absolute;right:16px;bottom:10px;font-size:5rem;opacity:.35;line-height:1}
.banner-dots{display:flex;justify-content:center;gap:6px;padding:10px 0 6px;background:var(--bg)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--pk3);transition:.3s;cursor:pointer}
.dot.active{background:var(--pk);width:20px;border-radius:4px}

/* ── FLASH SALE ── */
.flash-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px}
.flash-label{font-size:0.85rem;font-weight:700;color:var(--pk);display:flex;align-items:center;gap:6px}
.flash-timer{background:var(--pk);color:#fff;border-radius:8px;padding:3px 10px;font-size:0.75rem;font-weight:700;letter-spacing:.5px}
.see-all{font-size:0.78rem;color:var(--pk);font-weight:600;cursor:pointer;background:none;border:none;font-family:'Sora',sans-serif}
.h-scroll{display:flex;gap:12px;padding:4px 16px 12px;overflow-x:auto;scrollbar-width:none}
.h-scroll::-webkit-scrollbar{display:none}

/* ── PRODUCT CARD (compact) ── */
.pc{background:var(--card);border-radius:var(--r);overflow:hidden;border:1px solid var(--bdr);transition:.22s;cursor:pointer;flex-shrink:0;width:148px;box-shadow:0 1px 6px rgba(0,0,0,.05)}
.pc:hover{box-shadow:var(--sh2);transform:translateY(-3px);border-color:var(--pk2)}
.pc-img{width:100%;height:120px;display:flex;align-items:center;justify-content:center;font-size:3rem;position:relative}
.pc-disc{position:absolute;top:7px;left:7px;background:var(--pk);color:#fff;font-size:0.65rem;font-weight:700;padding:2px 7px;border-radius:4px}
.pc-badge{position:absolute;top:7px;right:7px;background:var(--gd);color:#fff;font-size:0.6rem;font-weight:700;padding:2px 7px;border-radius:4px}
.pc-body{padding:8px 10px 10px}
.pc-name{font-size:0.78rem;font-weight:600;line-height:1.3;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pc-price{font-size:0.9rem;font-weight:800;color:var(--pk);font-family:'Fraunces',serif}
.pc-orig{font-size:0.68rem;color:var(--ink3);text-decoration:line-through;margin-left:4px}
.pc-sold{font-size:0.68rem;color:var(--ink3);margin-top:3px}
.pc-add{width:100%;background:var(--pk);color:#fff;border:none;border-radius:8px;padding:6px;font-size:0.72rem;font-weight:700;cursor:pointer;margin-top:7px;font-family:'Sora',sans-serif;transition:.15s}
.pc-add:hover{background:#C2005A}
.pc-add:active{transform:scale(0.96)}

/* ── CATEGORIES ── */
.cat-scroll{display:flex;gap:10px;padding:4px 16px 12px;overflow-x:auto;scrollbar-width:none}
.cat-scroll::-webkit-scrollbar{display:none}
.cat-chip{display:flex;flex-direction:column;align-items:center;gap:5px;flex-shrink:0;cursor:pointer;transition:.2s}
.cat-chip .cc-icon{width:56px;height:56px;border-radius:16px;background:var(--pk4);display:flex;align-items:center;justify-content:center;font-size:1.6rem;transition:.2s;border:2px solid transparent}
.cat-chip .cc-lbl{font-size:0.68rem;font-weight:600;color:var(--ink2);text-align:center;max-width:60px;line-height:1.2}
.cat-chip:hover .cc-icon,.cat-chip.active .cc-icon{background:var(--pk3);border-color:var(--pk);transform:scale(1.06)}
.cat-chip.active .cc-lbl{color:var(--pk);font-weight:700}

/* ── SECTION HEADER ── */
.sec{padding:14px 16px 6px;display:flex;align-items:center;justify-content:space-between}
.sec h3{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:700;color:var(--ink)}
.sec-line{display:flex;align-items:center;gap:8px}
.sec-line::before{content:'';width:4px;height:18px;background:var(--pk);border-radius:2px;display:block}

/* ── GRID (2-col) ── */
.prod-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:6px 12px}
.prod-grid .pc{width:100%}

/* ── SHOP PAGE FILTERS ── */
.filter-bar{display:flex;gap:8px;padding:10px 12px;overflow-x:auto;scrollbar-width:none;background:var(--white);border-bottom:1px solid var(--bdr)}
.filter-bar::-webkit-scrollbar{display:none}
.f-chip{flex-shrink:0;background:var(--bg);border:1.5px solid var(--bdr);border-radius:var(--r3);padding:6px 14px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:600;color:var(--ink2);cursor:pointer;transition:.15s;white-space:nowrap}
.f-chip.active,.f-chip:hover{background:var(--pk);border-color:var(--pk);color:#fff}
.sort-bar{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--white);border-bottom:1px solid var(--bdr)}
.sort-lbl{font-size:0.75rem;color:var(--ink3);font-weight:600;white-space:nowrap}
.sort-btn{background:none;border:1px solid var(--bdr);border-radius:8px;padding:5px 12px;font-family:'Sora',sans-serif;font-size:0.73rem;font-weight:600;color:var(--ink2);cursor:pointer;white-space:nowrap;transition:.15s}
.sort-btn.active,.sort-btn:hover{background:var(--pk3);border-color:var(--pk2);color:var(--pk)}

/* ── WISHLIST HEART ── */
.heart-btn{position:absolute;top:7px;right:7px;background:rgba(255,255,255,.85);border:none;border-radius:50%;width:26px;height:26px;font-size:0.85rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;z-index:2}
.heart-btn:hover{background:#fff;transform:scale(1.15)}
.heart-btn.loved{color:var(--pk)}

/* ── CART PAGE ── */
.cart-page{padding:0 0 100px}
.cart-empty{text-align:center;padding:60px 20px}
.cart-empty .big-icon{font-size:4rem;display:block;margin-bottom:12px}
.cart-empty p{font-size:0.9rem;color:var(--ink3);margin-bottom:20px}
.go-shop-btn{background:var(--pk);color:#fff;border:none;border-radius:var(--r3);padding:12px 32px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;cursor:pointer}
.cart-section-title{padding:14px 16px 8px;font-size:0.8rem;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.5px}
.cart-item{background:var(--white);margin:0 0 2px;padding:14px 16px;display:flex;gap:12px;align-items:flex-start}
.ci-emoji{width:64px;height:64px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:2.2rem;flex-shrink:0}
.ci-info{flex:1;min-width:0}
.ci-name{font-size:0.85rem;font-weight:600;line-height:1.3;margin-bottom:4px}
.ci-variant{font-size:0.72rem;color:var(--ink3);background:var(--bg);border-radius:6px;padding:2px 8px;display:inline-block;margin-bottom:8px}
.ci-bottom{display:flex;align-items:center;justify-content:space-between}
.ci-price-big{font-family:'Fraunces',serif;font-size:1rem;font-weight:700;color:var(--pk)}
.qty-ctrl{display:flex;align-items:center;gap:8px;background:var(--bg);border-radius:10px;padding:4px 10px}
.qty-btn{background:none;border:none;color:var(--pk);font-size:1.1rem;font-weight:700;cursor:pointer;width:20px;height:20px;display:flex;align-items:center;justify-content:center;line-height:1}
.qty-n{font-size:0.85rem;font-weight:700;min-width:20px;text-align:center}
.ci-check{width:20px;height:20px;border-radius:6px;border:2px solid var(--bdr);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s;align-self:center}
.ci-check.checked{background:var(--pk);border-color:var(--pk);color:#fff;font-size:0.7rem}

/* ── ORDER SUMMARY STICKY ── */
.order-sticky{position:fixed;bottom:0;left:0;right:0;background:var(--white);border-top:1px solid var(--bdr);padding:12px 16px;z-index:150;box-shadow:0 -4px 20px rgba(0,0,0,.08)}
.os-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}
.os-check-all{display:flex;align-items:center;gap:8px;font-size:0.8rem;font-weight:600;cursor:pointer}
.os-check-all .check-box{width:20px;height:20px;border-radius:6px;border:2px solid var(--bdr);display:flex;align-items:center;justify-content:center;transition:.15s;flex-shrink:0}
.os-check-all .check-box.all-checked{background:var(--pk);border-color:var(--pk);color:#fff;font-size:0.7rem}
.os-total-wrap{display:flex;flex-direction:column;align-items:flex-end}
.os-total-lbl{font-size:0.7rem;color:var(--ink3)}
.os-total-num{font-family:'Fraunces',serif;font-size:1.15rem;font-weight:900;color:var(--pk)}
.checkout-btn{background:linear-gradient(135deg,var(--pk),#C2005A);color:#fff;border:none;border-radius:var(--r);padding:12px 24px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.88rem;cursor:pointer;white-space:nowrap;transition:.15s;box-shadow:0 4px 14px rgba(255,45,122,.35)}
.checkout-btn:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(255,45,122,.45)}
.checkout-btn:disabled{background:var(--ink3);box-shadow:none}

/* ── VOUCHER BAR ── */
.voucher-bar{background:var(--pk4);border:1px dashed var(--pk2);border-radius:12px;margin:10px 12px;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.vb-left{display:flex;align-items:center;gap:10px;font-size:0.82rem;font-weight:600;color:var(--pk)}
.vb-arrow{color:var(--pk);font-size:1rem}

/* ── CHECKOUT PAGE ── */
.ck-section{background:var(--white);margin-bottom:8px;padding:16px}
.ck-section-title{font-size:0.78rem;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.ck-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--bdr);font-size:0.85rem}
.ck-row:last-child{border:none}
.ck-label{color:var(--ink3)}
.ck-val{font-weight:600}
.ck-total-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0}
.ck-total-label{font-size:0.9rem;font-weight:700}
.ck-total-val{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:900;color:var(--pk)}
.inp{width:100%;border:1.5px solid var(--bdr);border-radius:var(--r);padding:11px 14px;font-family:'Sora',sans-serif;font-size:0.85rem;color:var(--ink);background:var(--bg);outline:none;transition:.2s;margin-bottom:10px}
.inp:focus{border-color:var(--pk);background:#fff}
.sel{width:100%;border:1.5px solid var(--bdr);border-radius:var(--r);padding:11px 14px;font-family:'Sora',sans-serif;font-size:0.85rem;color:var(--ink);background:var(--bg);outline:none;cursor:pointer;margin-bottom:10px;-webkit-appearance:none}
.pay-method-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.pay-opt{border:2px solid var(--bdr);border-radius:var(--r);padding:10px 12px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:8px;font-size:0.82rem;font-weight:600}
.pay-opt.active{border-color:var(--pk);background:var(--pk4);color:var(--pk)}
.pay-opt .pay-icon{font-size:1.2rem}
.place-order-btn{width:100%;background:linear-gradient(135deg,var(--pk),#C2005A);color:#fff;border:none;border-radius:var(--r);padding:15px;font-family:'Sora',sans-serif;font-weight:800;font-size:1rem;cursor:pointer;box-shadow:0 4px 14px rgba(255,45,122,.35);transition:.15s;margin-top:4px}
.place-order-btn:hover{transform:translateY(-1px)}

/* ── ORDERS PAGE ── */
.order-card{background:var(--white);border-radius:0;border-bottom:8px solid var(--bg);padding:16px;margin-bottom:0}
.oc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.oc-id{font-size:0.75rem;font-weight:700;color:var(--ink3)}
.status-pill{padding:4px 12px;border-radius:var(--r3);font-size:0.72rem;font-weight:700}
.sp-pending{background:#FEF3C7;color:#92400E}
.sp-paid{background:#D1FAE5;color:#065F46}
.sp-process{background:#DBEAFE;color:#1E40AF}
.sp-done{background:#EDE9FE;color:#5B21B6}
.sp-cancel{background:#FEE2E2;color:#991B1B}
.oc-items-row{display:flex;gap:10px;margin-bottom:12px;overflow-x:auto;scrollbar-width:none}
.oc-item-thumb{display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0}
.oc-thumb-img{width:56px;height:56px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;background:var(--pk4)}
.oc-thumb-qty{font-size:0.65rem;color:var(--ink3)}
.oc-meta{display:flex;justify-content:space-between;align-items:flex-end}
.oc-customer-info{font-size:0.78rem;color:var(--ink3);line-height:1.6}
.oc-price-section{text-align:right}
.oc-total{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:800;color:var(--pk)}
.oc-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.oc-btn{border:none;border-radius:8px;padding:7px 14px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:700;cursor:pointer;transition:.15s}
.oc-btn-pay{background:var(--pk);color:#fff}
.oc-btn-done{background:var(--gr);color:#fff}
.oc-btn-cancel{background:var(--bg);border:1px solid var(--bdr);color:var(--ink3)}
.oc-btn:hover{opacity:.88;transform:translateY(-1px)}

/* ── STATS ── */
.stats-wrap{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}
.stat-card{background:var(--white);border-radius:var(--r);padding:14px;border:1px solid var(--bdr)}
.stat-emoji{font-size:1.5rem;margin-bottom:6px}
.stat-val{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:900;color:var(--pk);line-height:1}
.stat-val.gold{color:var(--gd)}
.stat-val.pu{color:var(--pu)}
.stat-val.gr{color:var(--gr)}
.stat-lbl{font-size:0.7rem;color:var(--ink3);font-weight:600;margin-top:4px}

/* ── PRODUCT DETAIL (Modal/Sheet) ── */
.sheet-overlay{display:none;position:fixed;inset:0;background:rgba(15,14,26,.55);z-index:300;align-items:flex-end}
.sheet-overlay.open{display:flex}
.sheet{background:var(--white);border-radius:24px 24px 0 0;width:100%;max-height:92vh;overflow-y:auto;animation:sheetUp .28s cubic-bezier(.4,0,.2,1)}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet-drag{width:40px;height:4px;background:var(--bdr);border-radius:2px;margin:12px auto}
.sheet-close{position:absolute;top:16px;right:16px;background:var(--bg);border:none;border-radius:50%;width:32px;height:32px;font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center}
.sheet-img{height:220px;display:flex;align-items:center;justify-content:center;font-size:6rem;background:var(--pk4);margin:0 16px;border-radius:var(--r2)}
.sheet-body{padding:16px}
.sheet-cat{font-size:0.72rem;font-weight:700;color:var(--pk);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.sheet-name{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:700;line-height:1.3;margin-bottom:8px}
.sheet-rating{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:0.8rem}
.stars{color:var(--gd);letter-spacing:-1px}
.rating-num{font-weight:700}
.rating-sold{color:var(--ink3)}
.sheet-price{font-family:'Fraunces',serif;font-size:1.6rem;font-weight:900;color:var(--pk);margin-bottom:4px}
.sheet-orig{font-size:0.82rem;color:var(--ink3);text-decoration:line-through;margin-bottom:12px}
.sheet-desc{font-size:0.83rem;color:var(--ink2);line-height:1.7;margin-bottom:16px}
.qty-sheet{display:flex;align-items:center;gap:0;border:1.5px solid var(--bdr);border-radius:12px;overflow:hidden;width:fit-content;margin-bottom:16px}
.qty-sheet-btn{background:var(--bg);border:none;padding:10px 16px;font-size:1.1rem;font-weight:700;cursor:pointer;color:var(--pk);transition:.15s}
.qty-sheet-btn:hover{background:var(--pk3)}
.qty-sheet-n{padding:10px 18px;font-weight:700;font-size:0.95rem;border-left:1px solid var(--bdr);border-right:1px solid var(--bdr)}
.sheet-actions{display:grid;grid-template-columns:1fr 2fr;gap:10px;padding-bottom:20px}
.btn-wishlist{background:var(--pk4);border:1.5px solid var(--pk2);color:var(--pk);border-radius:var(--r);padding:13px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.85rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:.15s}
.btn-wishlist:hover{background:var(--pk3)}
.btn-addcart{background:linear-gradient(135deg,var(--pk),#C2005A);color:#fff;border:none;border-radius:var(--r);padding:13px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.88rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 4px 14px rgba(255,45,122,.3);transition:.15s}
.btn-addcart:hover{transform:translateY(-1px)}

/* ── VOUCHER MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(15,14,26,.6);z-index:400;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal-box{background:var(--white);border-radius:var(--r2);width:100%;max-width:380px;overflow:hidden;animation:popIn .25s ease}
@keyframes popIn{from{transform:scale(.9);opacity:0}to{transform:scale(1);opacity:1}}
.modal-hdr{background:linear-gradient(135deg,var(--pk),#C2005A);padding:20px;color:#fff;position:relative}
.modal-hdr h3{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:700}
.modal-hdr p{font-size:0.78rem;opacity:.85;margin-top:4px}
.modal-close-btn{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.2);border:none;border-radius:50%;width:28px;height:28px;color:#fff;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center}
.modal-body{padding:16px}
.voucher-input-row{display:flex;gap:8px;margin-bottom:14px}
.voucher-input-row input{flex:1;border:1.5px solid var(--bdr);border-radius:10px;padding:10px 14px;font-family:'Sora',sans-serif;font-size:0.85rem;outline:none;transition:.2s}
.voucher-input-row input:focus{border-color:var(--pk)}
.voucher-input-row button{background:var(--pk);color:#fff;border:none;border-radius:10px;padding:10px 16px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.82rem;cursor:pointer}
.voucher-list{display:flex;flex-direction:column;gap:8px}
.voucher-item{border:1.5px dashed var(--pk2);border-radius:12px;padding:12px 14px;cursor:pointer;transition:.2s;position:relative;overflow:hidden}
.voucher-item:hover,.voucher-item.selected{border-color:var(--pk);background:var(--pk4)}
.vi-code{font-weight:800;font-size:0.88rem;color:var(--pk);font-family:'Sora',sans-serif;letter-spacing:1px}
.vi-desc{font-size:0.75rem;color:var(--ink2);margin-top:3px}
.vi-min{font-size:0.7rem;color:var(--ink3);margin-top:2px}
.vi-check{position:absolute;top:10px;right:12px;font-size:1rem}
.modal-apply-btn{width:100%;background:var(--pk);color:#fff;border:none;border-radius:12px;padding:13px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;cursor:pointer;margin-top:14px}

/* ── SUCCESS MODAL ── */
.success-modal{display:none;position:fixed;inset:0;background:rgba(15,14,26,.6);z-index:500;align-items:center;justify-content:center;padding:20px}
.success-modal.open{display:flex}
.sm-box{background:var(--white);border-radius:var(--r2);width:100%;max-width:360px;padding:32px 24px;text-align:center;animation:popIn .25s ease}
.sm-anim{font-size:4.5rem;display:block;margin-bottom:12px;animation:bounce .6s ease .1s}
@keyframes bounce{0%,100%{transform:translateY(0) scale(1)}40%{transform:translateY(-16px) scale(1.1)}70%{transform:translateY(-6px)}}
.sm-title{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:900;color:var(--ink);margin-bottom:6px}
.sm-sub{font-size:0.85rem;color:var(--ink3);margin-bottom:20px;line-height:1.6}
.sm-detail{background:var(--pk4);border-radius:12px;padding:14px;text-align:left;margin-bottom:20px;font-size:0.83rem}
.sm-row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--pk3)}
.sm-row:last-child{border:none;font-weight:700;color:var(--pk)}
.sm-ok-btn{width:100%;background:var(--pk);color:#fff;border:none;border-radius:12px;padding:14px;font-family:'Sora',sans-serif;font-weight:700;font-size:0.95rem;cursor:pointer}

/* ── WISHLIST PAGE ── */
.empty-wish{text-align:center;padding:60px 20px}

/* ── TOAST ── */
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 20px;border-radius:var(--r3);font-size:0.82rem;font-weight:600;z-index:600;display:none;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}
#toast.show{display:block;animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateX(-50%) translateY(12px);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}

/* ── RATING STARS ROW ── */
.mini-stars{color:var(--gd);font-size:0.65rem;display:inline}

/* ── PROFILE PAGE ── */
.profile-header{background:linear-gradient(135deg,var(--pk),#C2005A);padding:28px 16px 20px;color:#fff;text-align:center}
.ph-avatar{width:70px;height:70px;border-radius:50%;background:rgba(255,255,255,.2);border:3px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 10px}
.ph-name{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:700}
.ph-email{font-size:0.78rem;opacity:.8;margin-top:3px}
.ph-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;background:var(--white);border-radius:var(--r2);margin:12px 12px 0;box-shadow:var(--sh);overflow:hidden}
.ph-stat{padding:14px;text-align:center;border-right:1px solid var(--bdr)}
.ph-stat:last-child{border:none}
.ph-stat-val{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:900;color:var(--pk)}
.ph-stat-lbl{font-size:0.68rem;color:var(--ink3);margin-top:2px}
.menu-list{background:var(--white);margin:10px 0;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr)}
.menu-item{display:flex;align-items:center;gap:12px;padding:15px 16px;border-bottom:1px solid var(--bdr);cursor:pointer;transition:.15s}
.menu-item:last-child{border:none}
.menu-item:hover{background:var(--bg)}
.mi-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.mi-text{flex:1}
.mi-title{font-size:0.85rem;font-weight:600}
.mi-sub{font-size:0.72rem;color:var(--ink3);margin-top:2px}
.mi-arrow{color:var(--ink3);font-size:0.85rem}

/* ── PROGRESS BAR ── */
.progress-track{background:var(--bdr);border-radius:3px;height:5px;margin:8px 0 4px}
.progress-bar{background:linear-gradient(90deg,var(--pk),var(--pk2));border-radius:3px;height:5px;transition:width .4s}

/* ── REVIEW SECTION ── */
.review-item{padding:12px 0;border-bottom:1px solid var(--bdr)}
.review-item:last-child{border:none}
.ri-top{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.ri-avatar{width:30px;height:30px;border-radius:50%;background:var(--pk3);display:flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0}
.ri-name{font-size:0.8rem;font-weight:600}
.ri-date{font-size:0.7rem;color:var(--ink3);margin-left:auto}
.ri-text{font-size:0.8rem;color:var(--ink2);line-height:1.6}

/* ── SCROLL TOP BTN ── */
#scroll-top{position:fixed;right:16px;bottom:100px;background:var(--pk);color:#fff;border:none;border-radius:50%;width:40px;height:40px;font-size:1.1rem;cursor:pointer;box-shadow:var(--sh2);display:none;z-index:100;align-items:center;justify-content:center;transition:.2s}
#scroll-top.show{display:flex}

/* ── BOTTOM NAV (mobile) ── */
.bottom-nav{display:none}
@media(max-width:640px){
  .bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;background:var(--white);border-top:1px solid var(--bdr);z-index:150;height:62px}
  .bn-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:none;border:none;cursor:pointer;font-family:'Sora',sans-serif;font-size:0.62rem;font-weight:600;color:var(--ink3);transition:.15s;position:relative}
  .bn-btn .bi{font-size:1.25rem}
  .bn-btn.active{color:var(--pk)}
  .bn-btn .bn-badge{position:absolute;top:6px;right:calc(50% - 20px);background:var(--pk);color:#fff;border-radius:50%;width:16px;height:16px;font-size:0.58rem;font-weight:700;display:flex;align-items:center;justify-content:center}
  .page{padding-bottom:70px}
  .order-sticky{bottom:62px}
}
</style>
</head>
<body>

<!-- TOP BAR -->
<div id="topbar">
  <div class="tb-row1">
    <div class="tb-logo" onclick="showPage('home')">Party<span>Bliss</span></div>
    <div class="search-wrap-tb">
      <span class="search-icon-tb">🔍</span>
      <input class="tb-search" id="search-input" placeholder="Cari produk, kategori..." oninput="liveSearch()">
    </div>
    <div class="tb-icons">
      <button class="tb-icon-btn" onclick="showPage('wishlist')" title="Wishlist">❤️</button>
      <button class="tb-icon-btn" onclick="showPage('cart')" title="Keranjang">
        🛒<span class="tb-badge" id="cart-badge">0</span>
      </button>
    </div>
  </div>
  <div class="tb-row2" id="tab-row">
    <button class="tab-btn active" onclick="showPage('home')" data-page="home"><span class="ti">🏠</span>Beranda</button>
    <button class="tab-btn" onclick="showPage('shop')" data-page="shop"><span class="ti">🛍️</span>Produk</button>
    <button class="tab-btn" onclick="showPage('cart')" data-page="cart"><span class="ti">🛒</span>Keranjang</button>
    <button class="tab-btn" onclick="showPage('orders')" data-page="orders"><span class="ti">📦</span>Pesanan</button>
    <button class="tab-btn" onclick="showPage('profile')" data-page="profile"><span class="ti">👤</span>Akun</button>
  </div>
</div>

<!-- HOME PAGE -->
<div id="page-home" class="page active">
  <!-- Banner Slider -->
  <div class="banner-wrap">
    <div class="banner-track" id="banner-track">
      <div class="banner-slide bs0">
        <div class="banner-text">
          <h2>Pesta Makin Meriah<br>Bersama PartyBliss!</h2>
          <p>Koleksi dekorasi eksklusif mulai Rp 8.500</p>
          <button class="banner-btn" style="color:var(--pk)" onclick="showPage('shop')">Belanja Sekarang →</button>
        </div>
        <div class="banner-emoji">🎉</div>
      </div>
      <div class="banner-slide bs1">
        <div class="banner-text">
          <h2>Kotak Hantaran<br>Eksklusif ✨</h2>
          <p>Seserahan mewah untuk momen istimewa</p>
          <button class="banner-btn" style="color:var(--pu)" onclick="filterAndGo('Kotak Hantaran')">Lihat Koleksi →</button>
        </div>
        <div class="banner-emoji">🎁</div>
      </div>
      <div class="banner-slide bs2">
        <div class="banner-text">
          <h2>Flash Sale!<br>Diskon 25% 🔥</h2>
          <p>Balon Foil & Kertas Kado premium</p>
          <button class="banner-btn" style="color:var(--gd)" onclick="showPage('shop')">Claim Diskon →</button>
        </div>
        <div class="banner-emoji">⚡</div>
      </div>
      <div class="banner-slide bs3">
        <div class="banner-text">
          <h2>Kartu Ucapan<br>Cetak Timbul 💌</h2>
          <p>Embossed premium, sentuhan mewah</p>
          <button class="banner-btn" style="color:var(--tl)" onclick="filterAndGo('Kartu Ucapan')">Lihat Koleksi →</button>
        </div>
        <div class="banner-emoji">💌</div>
      </div>
    </div>
    <div class="banner-dots" id="banner-dots"></div>
  </div>

  <!-- Categories -->
  <div class="sec sec-line"><h3>Kategori</h3></div>
  <div class="cat-scroll" id="home-cats"></div>

  <!-- Flash Sale -->
  <div class="flash-bar">
    <div class="flash-label">⚡ Flash Sale <span class="flash-timer" id="flash-timer">02:45:30</span></div>
    <button class="see-all" onclick="showPage('shop')">Lihat Semua ›</button>
  </div>
  <div class="h-scroll" id="flash-sale-row"></div>

  <!-- New Arrival -->
  <div class="sec sec-line"><h3>Produk Baru 🆕</h3><button class="see-all" onclick="showPage('shop')">Semua ›</button></div>
  <div class="h-scroll" id="new-arrival-row"></div>

  <!-- Best Seller -->
  <div class="sec sec-line"><h3>Terlaris 🔥</h3></div>
  <div class="prod-grid" id="bestseller-grid"></div>
</div>

<!-- SHOP PAGE -->
<div id="page-shop" class="page">
  <div class="filter-bar" id="shop-filters"></div>
  <div class="sort-bar">
    <span class="sort-lbl">Urutkan:</span>
    <button class="sort-btn active" onclick="setSort('default',this)">Relevan</button>
    <button class="sort-btn" onclick="setSort('price_asc',this)">Termurah</button>
    <button class="sort-btn" onclick="setSort('price_desc',this)">Termahal</button>
    <button class="sort-btn" onclick="setSort('rating',this)">Rating</button>
    <button class="sort-btn" onclick="setSort('sold',this)">Terlaris</button>
  </div>
  <div class="prod-grid" id="shop-grid" style="padding:10px 12px"></div>
</div>

<!-- CART PAGE -->
<div id="page-cart" class="page cart-page">
  <div class="cart-section-title">🛒 Keranjang Belanja</div>
  <div id="cart-body"></div>
  <div class="order-sticky" id="cart-sticky" style="display:none">
    <div class="os-inner">
      <div class="os-check-all" onclick="toggleAll()">
        <div class="check-box" id="all-check-box">✓</div>
        <span>Semua</span>
      </div>
      <div class="os-total-wrap">
        <div class="os-total-lbl">Total:</div>
        <div class="os-total-num" id="cart-total-num">Rp 0</div>
      </div>
      <button class="checkout-btn" id="checkout-go-btn" onclick="showPage('checkout')">Beli (<span id="selected-count">0</span>)</button>
    </div>
  </div>
</div>

<!-- CHECKOUT PAGE -->
<div id="page-checkout" class="page" style="padding:0 0 100px">
  <div class="cart-section-title">📋 Detail Pesanan</div>
  <div id="ck-items-preview"></div>
  <div class="ck-section">
    <div class="ck-section-title">📍 Alamat Pengiriman</div>
    <input class="inp" id="ck-name" placeholder="Nama Penerima">
    <input class="inp" id="ck-phone" placeholder="No. WhatsApp (08xxxxxxxxxx)" type="tel">
    <input class="inp" id="ck-addr" placeholder="Alamat Lengkap (Jl., Kel., Kec.)">
    <select class="sel" id="ck-city">
      <option value="">Pilih Kota</option>
      <option>Bandung</option><option>Jakarta</option><option>Surabaya</option>
      <option>Yogyakarta</option><option>Semarang</option><option>Medan</option>
      <option>Makassar</option><option>Bekasi</option><option>Depok</option><option>Tangerang</option>
    </select>
    <select class="sel" id="ck-shipping">
      <option value="regular">JNE Regular – Rp 15.000 (2–4 hari)</option>
      <option value="express">JNE Express – Rp 25.000 (1–2 hari)</option>
      <option value="same_day">Same Day – Rp 35.000 (hari ini)</option>
      <option value="free">Gratis Ongkir (min. Rp 150.000)</option>
    </select>
  </div>
  <div class="ck-section">
    <div class="ck-section-title">💳 Metode Pembayaran</div>
    <div class="pay-method-grid" id="pay-method-grid"></div>
  </div>
  <div class="voucher-bar" onclick="openVoucherModal()">
    <div class="vb-left">🏷️ <span id="voucher-label">Pakai Voucher / Kode Promo</span></div>
    <span class="vb-arrow">›</span>
  </div>
  <div class="ck-section">
    <div class="ck-section-title">🧾 Ringkasan Pembayaran</div>
    <div id="ck-summary"></div>
    <div class="ck-total-row">
      <span class="ck-total-label">Total Bayar</span>
      <span class="ck-total-val" id="ck-grand-total">Rp 0</span>
    </div>
  </div>
  <div style="padding:0 12px 12px">
    <button class="place-order-btn" onclick="placeOrder()">🎉 Buat Pesanan</button>
  </div>
</div>

<!-- ORDERS PAGE -->
<div id="page-orders" class="page" style="padding:0 0 80px">
  <div class="stats-wrap" id="order-stats"></div>
  <div class="filter-bar" id="order-filters" style="padding:8px 12px;gap:8px"></div>
  <div id="orders-list"></div>
</div>

<!-- WISHLIST PAGE -->
<div id="page-wishlist" class="page">
  <div class="cart-section-title">❤️ Wishlist Kamu</div>
  <div id="wishlist-body"></div>
</div>

<!-- PROFILE PAGE -->
<div id="page-profile" class="page" style="padding:0 0 80px">
  <div class="profile-header">
    <div class="ph-avatar">🎀</div>
    <div class="ph-name" id="ph-name-txt">Hai, Pembeli! 👋</div>
    <div class="ph-email">Selamat datang di PartyBliss ✨</div>
  </div>
  <div class="ph-stats" id="ph-stats"></div>
  <div style="height:12px"></div>
  <div class="menu-list">
    <div class="menu-item" onclick="showPage('orders')">
      <div class="mi-icon" style="background:#FFF0F6">📦</div>
      <div class="mi-text"><div class="mi-title">Pesanan Saya</div><div class="mi-sub">Cek status pesanan kamu</div></div>
      <span class="mi-arrow">›</span>
    </div>
    <div class="menu-item" onclick="showPage('wishlist')">
      <div class="mi-icon" style="background:#FFF0F6">❤️</div>
      <div class="mi-text"><div class="mi-title">Wishlist</div><div class="mi-sub">Produk yang kamu simpan</div></div>
      <span class="mi-arrow">›</span>
    </div>
    <div class="menu-item" onclick="toast('🎟️ Voucher kamu: PARTY20, BLISS15, ULTAH25')">
      <div class="mi-icon" style="background:#FFF8E1">🏷️</div>
      <div class="mi-text"><div class="mi-title">Voucher Saya</div><div class="mi-sub">3 voucher tersedia</div></div>
      <span class="mi-arrow">›</span>
    </div>
    <div class="menu-item" onclick="toast('📍 Alamat tersimpan')">
      <div class="mi-icon" style="background:#E0FFF8">📍</div>
      <div class="mi-text"><div class="mi-title">Alamat Tersimpan</div><div class="mi-sub">Kelola alamat pengiriman</div></div>
      <span class="mi-arrow">›</span>
    </div>
    <div class="menu-item" onclick="toast('⭐ Halaman ulasan belum tersedia')">
      <div class="mi-icon" style="background:#EDE9FE">⭐</div>
      <div class="mi-text"><div class="mi-title">Ulasan Saya</div><div class="mi-sub">Produk yang sudah diulas</div></div>
      <span class="mi-arrow">›</span>
    </div>
    <div class="menu-item" onclick="toast('🔔 Notifikasi diaktifkan')">
      <div class="mi-icon" style="background:#FFF8E1">🔔</div>
      <div class="mi-text"><div class="mi-title">Notifikasi</div><div class="mi-sub">Atur preferensi notifikasi</div></div>
      <span class="mi-arrow">›</span>
    </div>
  </div>
  <div style="padding:16px;text-align:center;font-size:0.75rem;color:var(--ink3)">
    PartyBliss v2.0 — PWA by <strong style="color:var(--pk)">PartyBliss ✨</strong>
  </div>
</div>

<!-- PRODUCT DETAIL SHEET -->
<div class="sheet-overlay" id="pd-sheet">
  <div class="sheet" id="pd-sheet-inner">
    <div class="sheet-drag"></div>
    <button class="sheet-close" onclick="closeSheet()">✕</button>
    <div class="sheet-img" id="pd-emoji"></div>
    <div class="sheet-body">
      <div class="sheet-cat" id="pd-cat"></div>
      <div class="sheet-name" id="pd-name"></div>
      <div class="sheet-rating">
        <span class="stars" id="pd-stars"></span>
        <span class="rating-num" id="pd-rating"></span>
        <span class="rating-sold" id="pd-sold-info"></span>
      </div>
      <div class="sheet-price" id="pd-price"></div>
      <div class="sheet-orig" id="pd-orig"></div>
      <div class="sheet-desc" id="pd-desc"></div>
      <div class="qty-sheet">
        <button class="qty-sheet-btn" onclick="sheetQtyChange(-1)">−</button>
        <span class="qty-sheet-n" id="sheet-qty">1</span>
        <button class="qty-sheet-btn" onclick="sheetQtyChange(1)">+</button>
      </div>
      <!-- Reviews -->
      <div style="font-size:0.82rem;font-weight:700;color:var(--ink);margin-bottom:8px">Ulasan Pembeli</div>
      <div id="pd-reviews"></div>
      <div class="sheet-actions" style="margin-top:16px">
        <button class="btn-wishlist" id="pd-wish-btn" onclick="toggleWishlist()">❤️ Simpan</button>
        <button class="btn-addcart" onclick="addFromSheet()">🛒 + Keranjang</button>
      </div>
    </div>
  </div>
</div>

<!-- VOUCHER MODAL -->
<div class="modal-overlay" id="voucher-modal">
  <div class="modal-box">
    <div class="modal-hdr">
      <h3>🏷️ Pilih Voucher</h3>
